{
  "name": "@takt/pylon-cli",
  "version": "0.1.0",
  "description": "Agent-friendly command line interface for the Pylon API.",
  "keywords": [
    "pylon",
    "cli",
    "api",
    "agent",
    "support"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "pylon": "dist/pylon.js"
  },
  "files": [
    "dist",
    "openapi.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "build": "tsup",
    "dev": "tsx src/bin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm generate && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "openapi-typescript": "^7.5.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
